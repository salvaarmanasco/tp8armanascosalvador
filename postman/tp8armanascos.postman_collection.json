{
  "info": {
    "name": "TP8 - Inventario de productos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "productoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Crear producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/productos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Producto prueba TP8\",\n  \"precio\": 45000.5,\n  \"stock\": 25\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"productoId\", pm.response.json().id);",
              "pm.test(\"Disponible\", function () { pm.expect(pm.response.json().disponible).to.eql(true); });"
            ]
          }
        }
      ]
    },
